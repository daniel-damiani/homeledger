# Postgres (Compose service hostname is "db")
DATABASE_URL=postgresql://homeledger:homeledger@db:5432/homeledger?schema=public

# PIN unlock (change after first login)
APP_PIN=1234

# Signed session cookie secret (use a long random string in real use)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional: currency display
CURRENCY=USD

# Local Ollama (Docker reaches the host via host.docker.internal)
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Tool-capable model recommended: llama3.2, qwen2.5, etc.
OLLAMA_MODEL=llama3.2

# Node
NODE_ENV=production
