# Postgres (Compose service hostname is "db")
DATABASE_URL=postgresql://homeledger:homeledger@db:5432/homeledger?schema=public

# PIN unlock (change after first login)
APP_PIN=1234

# Signed session cookie secret (use a long random string in real use)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional: currency display
CURRENCY=USD

# Node
NODE_ENV=production