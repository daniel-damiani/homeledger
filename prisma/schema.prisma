generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppSettings {
  id                      Int      @id @default(1)
  pinHash                 String
  currency                String   @default("USD")
  monthStartDay           Int      @default(1)
  onboarded               Boolean  @default(false)
  /** Target surplus (income − non-transfer spending) to hit each calendar month. */
  monthlySavingsGoalCents Int      @default(0)
  /** Claimed SimpleFIN Access URL (includes Basic Auth credentials). Null until claimed. */
  simpleFinAccessUrl      String?
  updatedAt               DateTime @updatedAt
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT
  CASH
  INVESTMENT
  LOAN
  OTHER
}

enum TaxBucket {
  TRADITIONAL
  ROTH
  TAXABLE
  UNKNOWN
}

model Account {
  id           String        @id @default(cuid())
  name         String
  type         AccountType   @default(CHECKING)
  institution  String?
  currency     String        @default("USD")
  balanceCents Int           @default(0)
  archived     Boolean       @default(false)
  downloadUrl  String?
  /** SimpleFIN Bridge account ID — links this account to a live bank connection. */
  simpleFinId              String?   @unique
  /** Last successful SimpleFIN sync; used as start-date on next fetch. */
  simpleFinLastSyncAt      DateTime?
  /** Available balance as reported by SimpleFIN (may differ from posted balance). */
  availableBalanceCents    Int?
  /** Tax treatment for retirement projections. UNKNOWN infers from the account name. */
  taxBucket    TaxBucket     @default(UNKNOWN)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  importBatches ImportBatch[]
  recurringFrom RecurringPayment[] @relation("RecurringFrom")
  recurringTo   RecurringPayment[] @relation("RecurringTo")
  loanLinkRules LoanLinkRule[]
}

model Category {
  id           String         @id @default(cuid())
  name         String         @unique
  group        String
  icon         String?
  isIncome     Boolean        @default(false)
  isTransfer   Boolean        @default(false)
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())
  transactions Transaction[]
  rules        CategoryRule[]
  budgets      Budget[]
  recurring    RecurringPayment[]
  loanLinks    LoanLinkRule[]
}

model CategoryRule {
  id         String   @id @default(cuid())
  pattern    String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  priority   Int      @default(100)
  createdAt  DateTime @default(now())

  @@index([pattern])
}

model Transaction {
  id           String       @id @default(cuid())
  accountId    String
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date         DateTime
  payee        String
  memo         String?
  amountCents  Int
  categoryId   String?
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  externalId   String?
  importBatchId String?
  importBatch  ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  /** When set, this bank/checking txn already has a paired loan principal reduction. */
  loanMirrorId String?      @unique
  pending      Boolean      @default(false)
  /** Marked cleared during reconciliation — confirmed against the bank statement. */
  cleared      Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([accountId, externalId])
  @@index([date])
  @@index([categoryId])
  @@index([payee])
}

model Budget {
  id           String   @id @default(cuid())
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  month        String
  limitCents   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([categoryId, month])
  @@index([month])
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model Goal {
  id              String     @id @default(cuid())
  name            String
  targetCents     Int
  currentCents    Int        @default(0)
  targetDate      DateTime?
  status          GoalStatus @default(ACTIVE)
  accountId       String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model ImportBatch {
  id             String        @id @default(cuid())
  accountId      String
  account        Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  filename       String
  format         String
  rowCount       Int           @default(0)
  importedCount  Int           @default(0)
  skippedCount   Int           @default(0)
  undone         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  transactions   Transaction[]
}

model RecurringPayment {
  id            String    @id @default(cuid())
  name          String
  fromAccountId String
  fromAccount   Account   @relation("RecurringFrom", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccountId   String?
  toAccount     Account?  @relation("RecurringTo", fields: [toAccountId], references: [id], onDelete: SetNull)
  payee         String
  amountCents   Int
  dayOfMonth    Int
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  memo          String?
  active        Boolean   @default(true)
  lastPostedOn  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([active])
  @@index([fromAccountId])
}

/** Auto-apply imported checking debits to a loan when payee matches. */
model LoanLinkRule {
  id            String   @id @default(cuid())
  pattern       String
  loanAccountId String
  loanAccount   Account  @relation(fields: [loanAccountId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([pattern])
}

/** Singleton retirement-planning assumptions (id = 1). */
model RetirementProfile {
  id                       Int      @id @default(1)
  birthYear                Int?
  retireAge                Int      @default(65)
  longevityAge             Int      @default(95)
  /** Social Security at full retirement age (67), monthly. */
  ssFraMonthlyCents        Int      @default(0)
  /** Claiming age: typically 62, 67, or 70. */
  ssClaimAge               Int      @default(67)
  /** Null = use trailing-12-month tracker spend. */
  desiredAnnualSpendCents  Int?
  stockPct                 Int      @default(70)
  glidePath                Boolean  @default(false)
  includeSavings           Boolean  @default(false)
  extraMonthlySaveCents    Int      @default(0)
  stockReturnPct           Float    @default(7)
  bondReturnPct            Float    @default(4)
  inflationPct             Float    @default(2.5)
  traditionalTaxHaircutPct Int      @default(15)
  updatedAt                DateTime @updatedAt
}

enum PurchaseKind {
  HOUSE
  CAR
  CASH
}

/** Singleton big-purchase planner (id = 1). */
model PurchasePlan {
  id                      Int          @id @default(1)
  kind                    PurchaseKind @default(HOUSE)
  extraMonthlySaveCents   Int          @default(0)
  /** Monthly amount the user plans to put toward the purchase. Null = not set yet. */
  plannedMonthlySaveCents Int?
  extraIncomeCents        Int          @default(0)
  /** Null = use trailing ledger income for the selected lookback. Replaces inferred income when set. */
  incomeOverrideCents     Int?
  otherDebtMonthlyCents   Int          @default(0)
  replaceHousing          Boolean      @default(true)
  emergencyMonths         Float        @default(3)
  /** Months of transactions to average for income, spend, housing, surplus. */
  lookbackMonths          Int          @default(12)
  /** One-time cash not in checking/savings (home-sale proceeds, gift, etc.). */
  otherCashCents          Int          @default(0)
  /** Pre-tax household income for DTI. Null = DTI not computed. */
  grossAnnualIncomeCents  Int?

  housePriceCents         Int          @default(40000000)
  downPct                 Float        @default(20)
  mortgageRatePct         Float        @default(6.5)
  mortgageTermYears       Int          @default(30)
  propertyTaxPct          Float        @default(1)
  insuranceAnnualCents    Int          @default(150000)
  hoaMonthlyCents         Int          @default(0)
  pmiAnnualPct            Float        @default(0.5)
  maintenancePct          Float        @default(1)
  closingCostPct          Float        @default(3)
  /** Null = closingCostPct of price. Dollar quote when set. */
  closingCostOverrideCents Int?

  carPriceCents           Int          @default(3000000)
  carTaxPct               Float        @default(6)
  carFeesCents            Int          @default(50000)
  carDownPct              Float        @default(10)
  carRatePct              Float        @default(7)
  carTermMonths           Int          @default(60)
  carInsuranceMonthlyCents Int         @default(15000)

  cashTargetCents         Int          @default(1000000)
  /** Null = use liquid cash minus emergency floor. */
  cashSavedOverrideCents  Int?

  updatedAt               DateTime     @updatedAt
}