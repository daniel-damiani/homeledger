generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppSettings {
  id                      Int      @id @default(1)
  pinHash                 String
  currency                String   @default("USD")
  monthStartDay           Int      @default(1)
  onboarded               Boolean  @default(false)
  /** Target surplus (income − non-transfer spending) to hit each calendar month. */
  monthlySavingsGoalCents Int      @default(0)
  /** Claimed SimpleFIN Access URL (includes Basic Auth credentials). Null until claimed. */
  simpleFinAccessUrl      String?
  updatedAt               DateTime @updatedAt
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT
  CASH
  INVESTMENT
  LOAN
  OTHER
}

model Account {
  id           String        @id @default(cuid())
  name         String
  type         AccountType   @default(CHECKING)
  institution  String?
  currency     String        @default("USD")
  balanceCents Int           @default(0)
  archived     Boolean       @default(false)
  downloadUrl  String?
  /** SimpleFIN Bridge account ID — links this account to a live bank connection. */
  simpleFinId              String?   @unique
  /** Last successful SimpleFIN sync; used as start-date on next fetch. */
  simpleFinLastSyncAt      DateTime?
  /** Available balance as reported by SimpleFIN (may differ from posted balance). */
  availableBalanceCents    Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  importBatches ImportBatch[]
  recurringFrom RecurringPayment[] @relation("RecurringFrom")
  recurringTo   RecurringPayment[] @relation("RecurringTo")
  loanLinkRules LoanLinkRule[]
}

model Category {
  id           String         @id @default(cuid())
  name         String         @unique
  group        String
  icon         String?
  isIncome     Boolean        @default(false)
  isTransfer   Boolean        @default(false)
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())
  transactions Transaction[]
  rules        CategoryRule[]
  budgets      Budget[]
  recurring    RecurringPayment[]
  loanLinks    LoanLinkRule[]
}

model CategoryRule {
  id         String   @id @default(cuid())
  pattern    String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  priority   Int      @default(100)
  createdAt  DateTime @default(now())

  @@index([pattern])
}

model Transaction {
  id           String       @id @default(cuid())
  accountId    String
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date         DateTime
  payee        String
  memo         String?
  amountCents  Int
  categoryId   String?
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  externalId   String?
  importBatchId String?
  importBatch  ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  /** When set, this bank/checking txn already has a paired loan principal reduction. */
  loanMirrorId String?      @unique
  pending      Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([accountId, externalId])
  @@index([date])
  @@index([categoryId])
  @@index([payee])
}

model Budget {
  id           String   @id @default(cuid())
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  month        String
  limitCents   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([categoryId, month])
  @@index([month])
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model Goal {
  id              String     @id @default(cuid())
  name            String
  targetCents     Int
  currentCents    Int        @default(0)
  targetDate      DateTime?
  status          GoalStatus @default(ACTIVE)
  accountId       String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model ImportBatch {
  id             String        @id @default(cuid())
  accountId      String
  account        Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  filename       String
  format         String
  rowCount       Int           @default(0)
  importedCount  Int           @default(0)
  skippedCount   Int           @default(0)
  undone         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  transactions   Transaction[]
}

model RecurringPayment {
  id            String    @id @default(cuid())
  name          String
  fromAccountId String
  fromAccount   Account   @relation("RecurringFrom", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccountId   String?
  toAccount     Account?  @relation("RecurringTo", fields: [toAccountId], references: [id], onDelete: SetNull)
  payee         String
  amountCents   Int
  dayOfMonth    Int
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  memo          String?
  active        Boolean   @default(true)
  lastPostedOn  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([active])
  @@index([fromAccountId])
}

/** Auto-apply imported checking debits to a loan when payee matches. */
model LoanLinkRule {
  id            String   @id @default(cuid())
  pattern       String
  loanAccountId String
  loanAccount   Account  @relation(fields: [loanAccountId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([pattern])
}